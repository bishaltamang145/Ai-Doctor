LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Optional Beyond Presence avatar. Leave ENABLE_BEY_AVATAR=false for audio-only mode.
ENABLE_BEY_AVATAR=false
BEY_API_KEY=
HEALTH_BEY_AVATAR_ID=

# Voice responsiveness and branding
HEALTH_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
HEALTH_VOICE=Aoede
HEALTH_AUTO_GREETING=false

# Twilio SMS reminders — get these from https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxx   ← create at console.twilio.com/messaging/services
# DEFAULT_PATIENT_PHONE=+977xxxxxxxxxx
